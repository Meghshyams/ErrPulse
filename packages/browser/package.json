{
  "name": "@errpulse/browser",
  "version": "0.5.1",
  "description": "ErrPulse framework-agnostic browser SDK — catch every frontend error with one init() call",
  "license": "MIT",
  "author": "Meghshyam Sonar",
  "homepage": "https://github.com/Meghshyams/ErrPulse#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Meghshyams/ErrPulse.git",
    "directory": "packages/browser"
  },
  "keywords": [
    "error-monitoring",
    "error-tracking",
    "browser",
    "frontend",
    "errpulse",
    "debugging",
    "error-handler",
    "console-log",
    "fetch-error",
    "sentry-alternative",
    "observability",
    "logging",
    "error-reporting",
    "xhr-interceptor",
    "fetch-interceptor",
    "correlation-id",
    "vanilla-js",
    "vue",
    "svelte"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@errpulse/core": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
